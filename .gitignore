# Simulation output — regenerated on every run, never committed
runs/

# Secrets — never commit. .env.example is the safe, checked-in template.
.env
.env.*
!.env.example

# Rendered maps — rebuild with `python3 render_world.py`, never committed
*.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
env/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Raw Meshy exports — ~229MB of uncompressed source across 16 GLBs, 96% of it
# 4K PNG textures (geometry is only ~11MB and is genuinely lean). Process these
# into art/generated/ — for the 2D map that means 128px sprites via
# art/blender_rig.py; for 3D later, gltf-transform to resized/compressed
# textures. THAT output is small and IS committed, because it is what the
# renderer actually loads.
#
# Both paths are listed: art/source/ was the name in the original plan,
# art/Meshy/ is where the exports actually landed.
art/source/
art/Meshy/
