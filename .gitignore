# Simulation output — regenerated on every run, never committed
runs/

# Secrets — never commit. .env.example is the safe, checked-in template.
.env
.env.*
!.env.example

# Rendered maps — rebuild with `python3 render_world.py`, never committed
*.html

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
env/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Raw Meshy exports — ~200MB of uncompressed source (a single character is 6.1MB,
# 92% of it one 2048x2048 PNG). Process these into art/generated/models/ with
# gltf-transform; that output is ~5MB and IS committed, because it is what the
# renderer actually loads.
art/source/
